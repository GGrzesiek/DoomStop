<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: MainActivity draws its own title and handles the status bar inset. -->
    <style name="Theme.DoomStop" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <!-- Android < 15: light status bar with dark icons. On 15+ the bar is transparent. -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
